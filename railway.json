{
    "$schema": "https://railway.com/railpack.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "nixpacks": {
            "php": "8.4",
            "node": "20"
        }
    },
    "deploy": {
        "startCommand": "php artisan serve --host=0.0.0.0 --port=8080",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}
